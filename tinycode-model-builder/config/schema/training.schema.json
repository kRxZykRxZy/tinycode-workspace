{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinycode.local/schemas/training.schema.json",
  "title": "TinyCode training configuration",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "target_tokens": { "type": "integer", "minimum": 1000 },
    "batch_size": { "type": "integer", "minimum": 1 },
    "micro_batch_size": { "type": "integer", "minimum": 1 },
    "gradient_accumulation_steps": { "type": "integer", "minimum": 1 },
    "learning_rate": { "type": "number", "exclusiveMinimum": 0 },
    "min_learning_rate": { "type": "number", "exclusiveMinimum": 0 },
    "warmup_steps": { "type": "integer", "minimum": 0 },
    "weight_decay": { "type": "number", "minimum": 0 },
    "beta1": { "type": "number", "minimum": 0, "maximum": 1 },
    "beta2": { "type": "number", "minimum": 0, "maximum": 1 },
    "grad_clip": { "type": "number", "minimum": 0 },
    "optimizer": { "type": "string", "enum": ["adamw", "adam", "sgd"] },
    "precision": { "type": "string", "enum": ["auto", "float32", "fp32", "float16", "fp16", "bfloat16", "bf16"] },
    "seed": { "type": "integer" },
    "log_every": { "type": "integer", "minimum": 1 },
    "eval_every": { "type": "integer", "minimum": 1 },
    "checkpoint_every": { "type": "integer", "minimum": 1 },
    "max_hours": { "type": "number", "minimum": 0 },
    "val_split": { "type": "number", "minimum": 0, "exclusiveMaximum": 0.5 }
  },
  "required": ["target_tokens"]
}
