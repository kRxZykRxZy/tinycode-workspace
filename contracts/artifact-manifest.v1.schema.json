{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinycode.local/contracts/artifact-manifest.v1.schema.json",
  "title": "TinyCode artifact manifest",
  "description": "The versioned contract between the tinycode-model-builder and the tinycode-inference-engine.",
  "type": "object",
  "required": [
    "artifact_format_version",
    "model",
    "architecture",
    "parameters",
    "tokenizer",
    "weights",
    "controller"
  ],
  "additionalProperties": true,
  "properties": {
    "artifact_format_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "The version of this contract."
    },
    "created_at": { "type": "number" },
    "model": {
      "type": "object",
      "required": ["name", "version", "architecture_id"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "architecture_id": { "type": "string" }
      }
    },
    "architecture": {
      "type": "object",
      "required": [
        "vocab_size",
        "d_model",
        "n_layers",
        "n_heads",
        "d_ff",
        "context_length"
      ],
      "properties": {
        "vocab_size": { "type": "integer", "minimum": 1 },
        "d_model": { "type": "integer", "minimum": 1 },
        "n_layers": { "type": "integer", "minimum": 1 },
        "n_heads": { "type": "integer", "minimum": 1 },
        "d_ff": { "type": "integer", "minimum": 1 },
        "context_length": { "type": "integer", "const": 1024 },
        "norm_type": { "type": "string", "enum": ["layernorm", "rmsnorm"] },
        "norm_eps": { "type": "number", "exclusiveMinimum": 0 },
        "activation": { "type": "string", "enum": ["silu", "gelu"] },
        "position_encoding": { "type": "string", "enum": ["learned", "sinusoidal"] },
        "qkv_bias": { "type": "boolean" },
        "ff_bias": { "type": "boolean" },
        "head_bias": { "type": "boolean" },
        "tie_embeddings": { "type": "boolean" },
        "architecture_id": { "type": "string" }
      }
    },
    "parameters": {
      "type": "object",
      "required": ["requested_target", "actual_trainable"],
      "properties": {
        "requested_target": { "type": "integer", "minimum": 1 },
        "actual_trainable": { "type": "integer", "minimum": 1 },
        "verified": { "type": "boolean" },
        "breakdown": { "type": "object" }
      }
    },
    "tokenizer": {
      "type": "object",
      "required": ["fingerprint"],
      "properties": {
        "fingerprint": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "vocab_size": { "type": "integer", "minimum": 1 },
        "files": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "sha256": { "type": "string" },
              "size": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "weights": {
      "type": "object",
      "required": ["format", "file"],
      "properties": {
        "format": { "type": "string", "enum": ["safetensors", "pytorch", "gguf"] },
        "file": { "type": "string" },
        "sha256": { "type": "string" },
        "dtype": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 }
      }
    },
    "precisions": { "type": "array", "items": { "type": "string" } },
    "required_operators": { "type": "array", "items": { "type": "string" } },
    "controller": {
      "type": "object",
      "required": ["present"],
      "properties": {
        "present": { "type": "boolean" },
        "version": { "type": ["string", "null"] },
        "file": { "type": ["string", "null"] },
        "metadata_file": { "type": ["string", "null"] },
        "feature_schema": { "type": ["string", "null"] },
        "sha256": { "type": ["string", "null"] }
      }
    },
    "training": { "type": "object" },
    "export": { "type": "object" },
    "compatibility": {
      "type": "object",
      "properties": {
        "min_engine_version": { "type": "string" },
        "min_contract_version": { "type": "string" },
        "supported_backends": { "type": "array", "items": { "type": "string" } }
      }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["sha256"],
        "properties": {
          "sha256": { "type": "string" },
          "size": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
